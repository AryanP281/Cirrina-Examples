import
  "https://raw.githubusercontent.com/CollaborativeStateMachines/Cirrina/refs/heads/develop/src/main/resources/pkl/csm/csml.pkl"

local totalProducts = 10

jobControllerFSM = new csml.StateMachine {
  transient {
    ["productsCompleted"] = "0"
    ["totalProducts"] = "\(totalProducts)"
  }

  states {
    ["startingState"] = new csml.Initial {
      entry {
        new csml.Emit {
          event {
            topic = "eProcessMessage"
            data { ["msg"] = "Job started..." }
          }
          target = "messageProcessorFSM"
        }
      }

      always {
        new csml.Transition {
          to = "runningState"
        }
      }
    }

    ["runningState"] {
      on {
        ["eProductComplete"] {
          yields {
            new csml.Eval { expression = "productsCompleted = productsCompleted + 1" }
            new csml.Emit { event = new csml.Internal { topic = "eCheckJobDone" } }
          }
        }

        ["eCheckJobDone"] {
          to = "jobDoneState"
          provided = "productsCompleted >= totalProducts"
        }
      }
    }

    ["jobDoneState"] = new csml.Terminal {
      entry {
        new csml.Emit {
          event { topic = "eProcessMessage"; data { ["msg"] = "Job done..." } }
          target = "messageProcessorFSM"
        }
        new csml.Emit { event { topic = "eJobDone" } }
      }
    }
  }
}
