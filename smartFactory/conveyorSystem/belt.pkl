import
  "https://raw.githubusercontent.com/CollaborativeStateMachines/Cirrina/refs/heads/develop/src/main/resources/pkl/csm/csml.pkl"

import "../serviceTypes.pkl" as ServiceTypes
import "../variables.pkl" as Vars

beltFsm = new csml.StateMachine {
  states {
    ["loadingState"] = new csml.Initial {
      exit {
        new csml.Emit { event { topic = "eScanned" }; target = "monitorFSM" }
      }

      on {
        ["eObjectInvalid"] {
          to = "errorState"
        }
        ["eObjectValid"] {
          to = "transportingState"
        }
        ["eJobDone"] {
          to = "jobDoneState"
        }
      }
    }
    ["transportingState"] {
      entry {
        new csml.Invoke {
          type = ServiceTypes.stMoveBelt
        }
      }

      exit {
        new csml.Invoke {
          type = ServiceTypes.stStopBelt
        }
      }

      on {
        ["eStartUnload"] {
          to = "unloadingState"
          yields {
            new csml.Eval { expression = "\(Vars.vIsUnloading) = true" }
          }
        }
        ["eJobDone"] {
          to = "jobDoneState"
        }
      }
    }

    ["errorState"] {
      entry {
        new csml.Emit {
          event {
            topic = "eProcessMessage"
            data { ["msg"] = "Belt error: Invalid object detected" }
          }
          target = "messageProcessorFSM"
        }
      }

      on {
        ["eObjectValid"] {
          to = "transportingState"
        }
      }
    }

    ["jobDoneState"] = new csml.Terminal {}

    ["unloadingState"] {
      entry {
        new csml.Emit { event { topic = "eArmPickup" }; target = "armFSM" }
      }

      after {
        ["armPickupTimeout"] = new csml.Timeout {
          delay = "10000"
          triggers = new csml.Emit { event { topic = "eArmPickup" }; target = "armFSM" }
        }
      }

      on {
        ["eJobDone"] {
          to = "jobDoneState"

          yields {
            new csml.Eval { expression = "\(Vars.vIsUnloading) = false" }
          }
        }

        ["ePickedUp"] {
          to = "loadingState"
          yields { new csml.Eval { expression = "\(Vars.vIsUnloading) = false" } }
        }
      }
    }
  }
}
